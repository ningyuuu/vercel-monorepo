{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "paths": {
      "lib/*": ["lib/*"],
      "@/*": ["src/*"],
      "@ui/*": ["src/components/ui/*"],
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
