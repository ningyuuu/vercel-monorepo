{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "lib/*": ["src/lib/*"],
      "@/*": ["src/*"],
      "components/ui/*": ["src/components/ui/*"],
      "components/ui/button": ["src/components/ui/button.tsx"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
